# Copy to .env and fill in what you have. Everything works without keys (mock AI, simulated calls).

DATABASE_URL=sqlite:///./waste2worth.db
# Supabase / any Postgres later: DATABASE_URL=postgresql+psycopg://user:pass@host:5432/postgres  (pip install psycopg[binary])
UPLOAD_DIR=./uploads

# Vision: gemini (free tier, fast) | ollama (local, slow on CPU) | mock
VISION_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# ElevenLabs: speech-to-text, text-to-speech, and outbound NGO calls
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=

# Vakh (run `python -m scripts.vakh_login` once, then pick the tool from /api/integrations/vakh/tools)
VAKH_TOKEN_FILE=./.vakh_tokens.json
VAKH_POST_TOOL=
VAKH_FOOD_FORM_ID=

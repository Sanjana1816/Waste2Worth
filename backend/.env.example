# Copy to .env for local dev. On Railway, set these as service Variables instead.
# Everything works with no keys: mock AI, local photo storage, simulated NGO calls.

# --- Database ---
# Local: SQLite file. Production: the Supabase "Session pooler" connection string.
DATABASE_URL=sqlite:///./waste2worth.db
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Photo storage ---
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
# STORAGE_BACKEND=supabase
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_BUCKET=listing-photos

# --- CORS: your frontend URLs (JSON list) ---
CORS_ORIGINS=["http://localhost:5173"]
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# --- Vision AI: groq | gemini | ollama | mock ---
VISION_PROVIDER=mock
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=

# --- Vakh (run `python -m scripts.vakh_login` once) ---
VAKH_TOKEN_FILE=./.vakh_tokens.json
VAKH_POST_TOOL=
VAKH_FOOD_FORM_ID=
# frontend URL, used for the "claim" link in Vakh posts (your Vercel URL in production)
PUBLIC_APP_URL=http://localhost:5173
